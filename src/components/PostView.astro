---
import Layout from '../layouts/Layout.astro'
import { render } from 'astro:content'
import { format } from 'date-fns'
import type { Post } from '../lib/posts'

interface Props {
  post: Post
}

const { post } = Astro.props
const Content = post.entry ? (await render(post.entry)).Content : undefined
---

<Layout title={post.data.title}>
  <article class="mx-auto max-w-xl py-8 px-4">
    <div class="mb-4">
      <a href="/" class="text-sm text-gray-500 hover:text-gray-900 underline">&larr; Back</a>
    </div>
    <div class="mb-8 text-center">
      <time datetime={post.data.date.toISOString()} class="mb-1 text-xs text-gray-600">
        {format(post.data.date, 'LLLL d, yyyy')}
      </time>
      <h1 class="text-3xl font-bold">{post.data.title}</h1>
      {post.data.author && <p class="text-gray-500 mt-2">{post.data.author}</p>}
    </div>
    <div class="prose prose-gray max-w-none">
      {Content ? <Content /> : <Fragment set:html={post.html} />}
    </div>
  </article>
</Layout>
