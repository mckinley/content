---
import NotFoundView from '../../components/NotFoundView.astro'
import PostView from '../../components/PostView.astro'
import { getCollection, type CollectionEntry } from 'astro:content'
import { getPreview } from '../../lib/cntmgmt'
import { draftProblem, getPosts } from '../../lib/posts'

// Prerendered on the site; rendered on request (with drafts) on the preview deployment.
export async function getStaticPaths() {
  return (await getCollection('posts')).map((post: CollectionEntry<'posts'>) => ({
    params: { id: post.id },
  }))
}

const posts = await getPosts(Astro.locals).catch((e: unknown) =>
  draftProblem(e, getPreview(Astro.locals)?.endpoint)
)
if (posts instanceof Response) return posts
const { id } = Astro.params as { id?: string }
const post = posts.find((p) => p.id === id)
if (!post) Astro.response.status = 404
---

{post ? <PostView post={post} /> : <NotFoundView />}
