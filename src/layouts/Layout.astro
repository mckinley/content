---
import '../styles/globals.css'

interface Props {
  title?: string
  description?: string
}

const {
  title = 'Content Layer Systems Demo',
  description = 'Comparing Keystatic, Velite, Astro Content Collections, and EditorJS for content management',
} = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body class="antialiased">
    <slot />
  </body>
</html>
