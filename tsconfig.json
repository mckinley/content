{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@/.velite": ["./.velite"]
    },
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  },
  "include": [
    "src",
    ".velite",
    "velite.config.ts",
    "keystatic.config.ts",
    "astro.config.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
