{
  "name": "content",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "velite && run-p dev:*",
    "dev:content": "velite --watch",
    "dev:astro": "astro dev",
    "build": "run-s build:content build:astro",
    "build:content": "velite --clean",
    "build:astro": "astro build",
    "preview": "astro preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "tc": "astro check",
    "check": "bun run format:check && bun run lint && bun run tc",
    "prep": "bun run format && bun run lint:fix",
    "ci": "bun run check"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.0.0",
    "@astrojs/react": "^4.0.0",
    "@editorjs/code": "^2.9.4",
    "@editorjs/editorjs": "^2.31.0",
    "@editorjs/header": "^2.8.8",
    "@editorjs/list": "^2.0.9",
    "@editorjs/quote": "^2.7.6",
    "@keystatic/astro": "^5.0.0",
    "@keystatic/core": "^0.5.48",
    "@markdoc/markdoc": "^0.4.0",
    "astro": "^5.0.0",
    "csv-parse": "^6.1.0",
    "date-fns": "^4.1.0",
    "editorjs-html": "^3.4.3",
    "jsdom": "^27.4.0",
    "json5": "^2.2.3",
    "npm-run-all": "^4.1.5",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "toml": "^3.0.0",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.8",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.2.2",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^20.19.27",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.2",
    "globals": "^17.4.0",
    "prettier": "^3.7.4",
    "prettier-plugin-astro": "^0.14.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.57.2",
    "velite": "^0.2.4"
  }
}
