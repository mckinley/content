{
  "name": "content",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "velite && run-p dev:*",
    "dev:content": "velite --watch",
    "dev:astro": "astro dev",
    "build": "run-s build:content build:astro",
    "build:content": "velite --clean",
    "build:astro": "astro build",
    "preview": "astro preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "tc": "astro check",
    "check": "bun run format:check && bun run lint && bun run tc",
    "prep": "bun run format && bun run lint:fix",
    "ci": "bun run check"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.9",
    "@astrojs/react": "^7.1.9",
    "@editorjs/code": "^2.9.4",
    "@editorjs/editorjs": "^2.31.7",
    "@editorjs/header": "^2.8.9",
    "@editorjs/list": "^2.0.9",
    "@editorjs/quote": "^2.7.6",
    "@keystatic/astro": "^6.0.0",
    "@keystatic/core": "^0.5.51",
    "@markdoc/markdoc": "^0.4.0",
    "astro": "^7.4.13",
    "csv-parse": "^6.2.1",
    "date-fns": "^4.4.0",
    "editorjs-html": "^3.4.3",
    "github-slugger": "^2.0.0",
    "js-yaml": "^4.3.2",
    "jsdom": "^27.4.0",
    "json5": "^2.2.3",
    "npm-run-all": "^4.1.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "remark-smartypants": "^3.0.3",
    "toml": "^5.0.1",
    "unified": "^11.0.5",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.5",
    "@types/js-yaml": "^4.0.9",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^0.14.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
